  "scenarios": [
    {
      "id": "EXPL-R01-two-player-start",
      "source": {
        "page": 1,
        "quote": "Zusätzlich erhält jeder Spieler eine Karte „Entschärfung“. So starten alle mit 8 Karten auf der Hand."
      },
      "initial": {
        "current_player": 0,
        "terminal": false,
        "returns": [0, 0],
        "legal_action_count_min": 1
      }
    },
    {
      "id": "EXPL-R02-normal-turn-can-end-by-drawing",
      "source": {
        "page": 1,
        "quote": "Du beendest deinen Zug, indem du die oberste Karte vom Spielstapel ziehst."
      },
      "initial": {
        "terminal": false,
        "legal_action_name_contains_any": ["draw", "ziehen", "pass"]
      }
    },
    {
      "id": "EXPL-R03-attack-hands-turn-to-next-player",
      "source": {
        "page": 2,
        "quote": "Du beendest deinen eigenen Zug, ohne eine Karte zu ziehen, und zwingst den nächsten Spieler, zwei Spielzüge direkt nacheinander auszuführen."
      },
      "search": {
        "action_contains_any": ["attack", "angriff", "doppelzug"],
        "max_rollouts": 300,
        "max_steps": 300,
        "seed": 11
      },
      "expect": {
        "terminal": false,
        "current_player_relation": "changed"
      }
    },
    {
      "id": "EXPL-R04-skip-does-not-end-game",
      "source": {
        "page": 2,
        "quote": "Beende sofort deinen Zug, ohne eine Karte zu ziehen."
      },
      "search": {
        "action_contains_any": ["skip", "hops", "überspringen"],
        "max_rollouts": 300,
        "max_steps": 300,
        "seed": 12
      },
      "expect": {
        "terminal": false
      }
    },
    {
      "id": "EXPL-R05-preview-keeps-current-turn",
      "source": {
        "page": 2,
        "quote": "Schau dir die obersten drei Karten des Spielstapels an und lege sie zurück, ohne deren Reihenfolge zu verändern."
      },
      "search": {
        "action_contains_any": ["see future", "future", "blick in die zukunft", "vorschau"],
