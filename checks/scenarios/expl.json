        "max_rollouts": 300,
        "max_steps": 300,
        "seed": 14
      },
      "expect": {
        "terminal": false,
        "current_player_relation": "same"
      }
    },
    {
      "id": "EXPL-R07-favor-keeps-current-turn",
      "source": {
        "page": 2,
