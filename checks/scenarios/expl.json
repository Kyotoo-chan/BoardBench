      "fact_ids": ["ATK-01"],
      "basis": "clear",
      "source": {
        "page": 2,
        "quote": "Du beendest deinen eigenen Zug, ohne eine Karte zu ziehen, und zwingst den nächsten Spieler, zwei Spielzüge direkt nacheinander auszuführen."
      },
      "fixture": {
        "hands": {"0": ["attack"], "1": []},
        "deck": ["shuffle"],
        "active_player": 0,
        "turns_owed": 1
      },
      "steps": [{
        "action": {"contains_any": ["attack", "angriff", "doppelzug", "double turn"]},
        "settle": [{
          "while_all_contains_any": ["pass", "nope", "noe", "nö", "doch"],
